# Copy to .env and fill in. .env is gitignored.

# console.anthropic.com -> API Keys. Set a monthly spend limit there too.
ANTHROPIC_API_KEY=

# Test-mode keys only. Never use live keys with this benchmark.
# Stripe: dashboard.stripe.com/test/apikeys -> "Secret key" (starts with sk_test_)
STRIPE_SECRET_KEY=

# HubSpot: create a free developer account, then a developer test account, then a
# private app (or service key) in the test account with CRM contacts, companies
# and deals read/write scopes. Runs refuse to start unless HubSpot reports the
# account type as DEVELOPER_TEST or SANDBOX.
HUBSPOT_ACCESS_TOKEN=
